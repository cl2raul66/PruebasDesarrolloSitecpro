# ==========================================
# CONFIGURACIÓN DEL BACKEND (.NET)
# ==========================================

# Entorno de ejecución
ASPNETCORE_ENVIRONMENT=Development

# Puerto de la API (Requerido por el enunciado: 5080)
ASPNETCORE_URLS=http://+:5080

# Cadena de conexión SQLite (Se creará en la carpeta del backend)
ConnectionStrings__DefaultConnection=Data Source=mesasitec.db

# Configuración JWT
# IMPORTANTE: En producción esta clave debe ser un secreto fuerte.
Jwt__Secret=SuperSecretoParaLaPruebaTecnicaMesaSitec2026!
Jwt__Issuer=MesaSitecApi
Jwt__Audience=MesaSitecClients
Jwt__ExpirationHours=8

# Fecha base para la generación de datos semilla (Requerido por el enunciado)
SEED_FECHA_BASE=2026-01-15T08:00:00Z

# ==========================================
# CONFIGURACIÓN DEL FRONTEND (Vite / Vue 3)
# ==========================================
# Nota: Vite requiere que las variables expuestas al cliente comiencen con VITE_

# URL base de la API
VITE_API_URL=http://localhost:5080/api/v1
